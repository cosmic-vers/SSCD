 a Write a YACC Program to recognize the grammar (anb, n>= 10). 

 %{
    #include <stdio.h>
    #include <ctype.h>
    #include <stdlib.h>

    int yylex(void);
    int yyerror(const char *s);
%}

%token ta tb

%%
S
    : T '\n' {
        printf("Valid\n");
        exit(0);
    }
    ;

T
    :
    | ta T tb
    ;
%%

int yylex(void)
{
    int c;

    while ((c = getchar()) == ' ')
        ;

    if (c == 'a')
        return ta;

    if (c == 'b')
        return tb;

    return c;
}

int main(void)
{
    yyparse();
    return 0;
}

int yyerror(const char *s)
{
    printf("Error\n");
    return 0;
}
